{
  "build": {
    "builder": "nixpacks",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python310", "poetry", "gcc", "g++", "openssl", "libffi", "sqlite"]
        },
        "install": {
          "commands": [
            "cd backend && poetry install"
          ]
        },
        "build": {
          "commands": [
            "echo 'Build completed'"
          ]
        },
        "start": {
          "command": "cd backend && poetry run uvicorn src.main:app --host 0.0.0.0 --port $PORT"
        }
      },
      "variables": {
        "PYTHONPATH": "/app/backend"
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "region": "us-west1",
    "ephemeralDisk": {
      "sizeGb": 5
    }
  }
}